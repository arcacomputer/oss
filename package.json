{
  "name": "arca-oss",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "astro check",
    "lint": "astro check",
    "check": "astro check && npm test && npm run test:activity",
    "build": "astro build && node scripts/check-built-site.mjs",
    "test:activity": "node --test scripts/update-public-activity.test.mjs scripts/contribution-outcomes.test.mjs scripts/update-github-repositories.test.mjs scripts/update-openclaw-ledger.test.mjs",
    "refresh:activity": "node scripts/update-public-activity.mjs && node scripts/update-github-repositories.mjs",
    "refresh:ledger": "node scripts/update-openclaw-ledger.mjs",
    "check:claims": "node scripts/check-public-claims.mjs",
    "cf:dev": "wrangler dev",
    "cf:dry-run": "wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.4",
    "astro": "^7.2.4",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "js-yaml": "^4.3.1",
    "sharp": "^0.35.3",
    "typescript": "^5.9.3",
    "wrangler": "^4.125.0"
  }
}
