---
import BaseLayout from '@/src/layouts/BaseLayout.astro';
import { companyName } from '@/lib/site';
---
<BaseLayout title={`Page not found | ${companyName}`}>
  <main class="not-found">
    <a class="company-name" href="/">{companyName}</a>
    <p class="eyebrow">404 / PAGE NOT FOUND</p>
    <h1>Page not found</h1>
    <p>The homepage lists our open-source contributions and the software we built.</p>
    <a class="button" href="/">Back to the homepage</a>
  </main>
</BaseLayout>
